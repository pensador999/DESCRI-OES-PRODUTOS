# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - ECOSSISTEMA BRK SHOPIFY (DESCRIÇÕES E SENTINELA)
# ==============================================================================
# Copie este arquivo para .env e preencha com os tokens privados da Shopify Admin API:
# Exemplo no Windows PowerShell: Copy-Item .env.example .env
# NUNCA envie o arquivo .env para o GitHub (ele já está no .gitignore).
# ==============================================================================

# 1. BRK Fishing (use-brk-fishing.myshopify.com)
# Permissões mínimas necessárias no Custom App: write_products, read_products
SHOPIFY_FISHING_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. BRK Agro (use-brk-agro.myshopify.com)
# Permissões mínimas necessárias no Custom App: write_products, read_products
SHOPIFY_AGRO_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. BRK Motors (use-brk-motors.myshopify.com)
# Permissões mínimas necessárias no Custom App: write_products, read_products
SHOPIFY_MOTORS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 4. Configurações Operacionais Opcionais
# SHOPIFY_API_VERSION=2024-01
# SYNC_REQUEST_DELAY=0.5
