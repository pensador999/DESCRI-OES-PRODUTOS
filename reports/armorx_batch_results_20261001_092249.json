nmax(240px, 1fr));\n      gap: 12px 20px;\n    }\n    .brk-spec-item {\n      display: flex;\n      flex-direction: column;\n      border-bottom: 1px dashed #e2e8f0;\n      padding-bottom: 8px;\n    }\n    .brk-spec-label {\n      font-size: 11px;\n      font-weight: 700;\n      text-transform: uppercase;\n      color: #64748b;\n    }\n    .brk-spec-value {\n      font-size: 13.5px;\n      font-weight: 600;\n      color: #1e293b;\n      margin-top: 2px;\n    }\n    @media (max-width: 768px) {\n      .brk-desc-block, .brk-desc-block.reverse {\n        flex-direction: column !important;\n        gap: 16px;\n        margin-bottom: 32px;\n        text-align: center;\n      }\n      .brk-desc-title {\n        font-size: 19px;\n      }\n      .brk-desc-paragraph {\n        font-size: 14px;\n      }\n      .brk-specs-grid {\n        grid-template-columns: 1fr;\n      }\n      .brk-spec-item {\n        text-align: left;\n      }\n    }\n  </style>\n\n  \n  <!-- Bloco 1: Proteção Solar UV50+ Homologada -->\n  <div class=\"brk-desc-block\">\n    <div class=\"brk-desc-media\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0628/1445/3826/files/246708f34b714adb975e4f56237d4841_2FproductOnChannel_2Fimages_2F185189729_2F9ef9008779624e0cb13b63af8aa10452.jpg?v=1788352829&width=900\" alt=\"Camisa ArmorX Feminina Camuflada Verde Militar com Luva e Proteção UV50 - Visão Geral e Modelagem Exclusiva\" loading=\"lazy\" />\n    </div>\n    <div class=\"brk-desc-text\">\n      <span class=\"brk-desc-tag\">Proteção Solar UV50+ Homologada</span>\n      <h3 class=\"brk-desc-title\">BLINDAGEM TOTAL CONTRA O SOL</h3>\n      <p class=\"brk-desc-paragraph\">A **Camisa ArmorX Feminina Camuflada Verde Militar com Luva e Proteção UV50** foi desenvolvida para pescadores e aventureiros que enfrentam longas jornadas sob sol intenso. Sua tecnologia têxtil com certificação permanente bloqueia até 98% dos raios UVA e UVB (FPU 50+), garantindo segurança absoluta para a sua pele sem sair nas lavagens.</p>\n    </div>\n  </div>\n  <!-- Bloco 2: Luva Integrada no Punho Passa-Dedo -->\n  <div class=\"brk-desc-block reverse\">\n    <div class=\"brk-desc-media\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0628/1445/3826/files/246708f34b714adb975e4f56237d4841_2FproductOnChannel_2Fimages_2F185189729_2Faa1acf3aa40d4a968d6b6a2e5899af05.jpg?v=1788352829&width=900\" alt=\"Camisa ArmorX Feminina Camuflada Verde Militar com Luva e Proteção UV50 - Detalhe da Luva Integrada e Punho Anatômico\" loading=\"lazy\" />\n    </div>\n    <div class=\"brk-desc-text\">\n      <span class=\"brk-desc-tag\">Luva Integrada no Punho Passa-Dedo</span>\n      <h3 class=\"brk-desc-title\">PROTEÇÃO ATÉ O DORSO DAS MÃOS</h3>\n      <p class=\"brk-desc-paragraph\">Com acabamento na tonalidade **Verde Militar**, o punho inteligente com encaixe para o polegar mantém a manga perfeitamente posicionada durante arremessos, recolhimentos ou pilotagem do barco. Protege o dorso das mãos contra queimaduras solares e atrito, preservando total sensibilidade no manuseio da carretilha.</p>\n    </div>\n  </div>\n  <!-- Bloco 3: Tecido XTech Pro Respirável -->\n  <div class=\"brk-desc-block\">\n    <div class=\"brk-desc-media\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0628/1445/3826/files/246708f34b714adb975e4f56237d4841_2FproductOnChannel_2Fimages_2F185189729_2F74904d5cbe6b4957ba17b87cddb63fd5.jpg?v=1788352829&width=900\" alt=\"Camisa ArmorX Feminina Camuflada Verde Militar com Luva e Proteção UV50 - Tecido XTech Pro e Caimento Perfeito\" loading=\"lazy\" />\n    </div>\n    <div class=\"brk-desc-text\">\n      <span class=\"brk-desc-tag\">Tecido XTech Pro Respirável</span>\n      <h3 class=\"brk-desc-title\">TOQUE MACIO E SECAGEM ULTRARRÁPIDA</h3>\n      <p class=\"brk-desc-paragraph\">Confeccionada com a consagrada microfibra XTech Pro com tecnologia Dry, a camisa evapora o suor quase instantaneamente, mantendo o corpo sempre seco e com sensação térmica agradável. Possui ação antibacteriana que inibe odores indesejados mesmo após horas de uso contínuo.</p>\n    </div>\n  </div>\n\n  <!-- Box de Especificacoes e Cuidados -->\n  <div class=\"brk-desc-specs-box\">\n    <h4 class=\"brk-desc-specs-title\">Ficha Técnica & Cuidados de Conservação</h4>\n    <div class=\"brk-specs-grid\">\n      <div class=\"brk-spec-item\">\n        <span class=\"brk-spec-label\">Linha</span>\n        <span class=\"brk-spec-value\">BRK ArmorX Performance</span>\n      </div>\n      <div class=\"brk-spec-item\">\n        <span class=\"brk-spec-label\">Proteção Solar</span>\n        <span class=\"brk-spec-value\">FPU 50+ Homologado (Bloqueia 98% dos raios UV)</span>\n      </div>\n      <div class=\"brk-spec-item\">\n        <span class=\"brk-spec-label\">Tecido</span>\n        <span class=\"brk-spec-value\">XTech Pro (90% Poliéster / 10% Elastano com toque suave)</span>\n      </div>\n      <div class=\"brk-spec-item\">\n        <span class=\"brk-spec-label\">Punho</span>\n        <span class=\"brk-spec-value\">Luva integrada anatômica com passa-dedo</span>\n      </div>\n      <div class=\"brk-spec-item\">\n        <span class=\"brk-spec-label\">Gola</span>\n        <span class=\"brk-spec-value\">Gola alta com zíper tratorado e puxador emborrachado</span>\n      </div>\n      <div class=\"brk-spec-item\">\n        <span class=\"brk-spec-label\">Secagem</span>\n        <span class=\"brk-spec-value\">Tecnologia Dry de evaporação ultrarrápida</span>\n      </div>\n      <div class=\"brk-spec-item\">\n        <span class=\"brk-spec-label\">Cuidados</span>\n        <span class=\"brk-spec-value\">Lavagem simples, não requer ferro de passar, secagem rápida à sombra</span>\n      </div>\n    </div>\n  </div>\n</div>"
  }
